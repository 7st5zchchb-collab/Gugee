DATABASE_URL=postgresql://user:password@localhost:5432/gugee
JWT_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# Optional: configure email before using verification and password reset.
RESEND_API_KEY=
EMAIL_FROM=Gugee <noreply@example.com>
# Optional: configure Stripe Checkout and webhook together.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave disabled until a merchant provider and business requirements are approved.
GUGEE_TRANSACTIONS_ENABLED=false
